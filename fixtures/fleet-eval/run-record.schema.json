{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jinwon-int/agent-olympics/fixtures/fleet-eval/run-record.schema.json",
  "title": "Fleet evaluation run record",
  "description": "One judged attempt of one Q-set item. One JSON object per line under fixtures/fleet-eval/runs/<YYYY-MM-DD>-<short sha>.jsonl. Body-free: the target output is never stored, only its hash and check outcomes. See docs/fleet-eval.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "qsetCommit",
    "itemId",
    "family",
    "itemVersion",
    "attempt",
    "target",
    "judge",
    "verdict",
    "score",
    "durationMs",
    "startedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "fleet-eval-run-v1"
    },
    "runId": {
      "type": "string",
      "description": "<YYYY-MM-DD>-<short sha>[-<suffix>]; shared by every record of one run.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{7,12}(-[a-z0-9-]+)?$"
    },
    "qsetCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "itemId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-[0-9]{3}$"
    },
    "family": {
      "type": "string",
      "enum": [
        "hande-reply",
        "skill-select",
        "a2a-verdict",
        "phone-intent"
      ]
    },
    "itemVersion": {
      "type": "integer",
      "minimum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Repeat index; the gate uses 3 attempts and a 2-of-3 pass rule."
    },
    "target": {
      "$ref": "#/$defs/lane"
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "rule",
            "llm"
          ]
        },
        "lane": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "ok"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "regex",
              "not_regex",
              "json_equals",
              "json_in",
              "json_includes_all",
              "json_excludes_all"
            ]
          },
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    "outputSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outputChars": {
      "type": "integer",
      "minimum": 0
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "timeout",
            "adapter_error",
            "unparseable_output",
            "judge_error"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "judge": {
            "properties": {
              "kind": {
                "const": "llm"
              }
            },
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "judge": {
            "required": [
              "kind",
              "lane",
              "model"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "$defs": {
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "model",
        "adapter"
      ],
      "properties": {
        "lane": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    }
  }
}
